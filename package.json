{
  "name": "excalidraw-portal",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx watch --env-file=.env.development src/index.ts",
    "test:code": "eslint src",
    "test:other": "prettier --check . --ignore-path=.gitignore",
    "test": "npm run test:other && npm run test:code",
    "fix:code": "npm run test:code -- --fix",
    "fix:other": "prettier --write . --ignore-path=.gitignore",
    "fix": "npm run fix:other && npm run fix:code"
  },
  "dependencies": {
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/debug": "4.1.13",
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
